# Unsplash API key (required)
UNSPLASH_KEY=

# Server bind address and port
HOST=127.0.0.1
PORT=3000

# Server-side cache TTL for /photos responses (milliseconds, default 12 hours)
CACHE_TTL=43200000

# Optional SOCKS5 proxy for Unsplash API requests
USE_PROXY=false
PROXY_HOST=
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=
